# Runtime only. Required: fill all three values before deployment.
# DATABASE_URL=postgresql://quality:URL_ENCODED_PASSWORD@postgres:5432/quality
# The DSN password must match POSTGRES_PASSWORD. A random hex password needs no encoding.
POSTGRES_PASSWORD=
DATABASE_URL=
ADMIN_TOKEN=
# Leave teacher values empty to deploy before GPU rental; worker stays idle.
# Once the server is running: TEACHER_BASE_URL=http(s)://HOST:PORT/v1
TEACHER_BASE_URL=
TEACHER_API_KEY=
TEACHER_MODEL=
TEACHER_PROFILE=
# API host publishing; Coolify proxy targets api container port 8000.
BIND_HOST=127.0.0.1
API_PORT=8000
# Compose fixes ARTIFACT_DIR=/artifacts at the named-volume mount.
MAX_DOCUMENT_BYTES=100000
MAX_ATTEMPTS=3
MAX_DATABASE_BYTES=8000000000
MAX_EXPORT_BYTES=1000000000
MIN_ARTIFACT_FREE_BYTES=2000000000
UNAPPROVED_JOB_CEILING=5000
# Separate from ADMIN_TOKEN. Leave unset until user explicitly authorizes a large run.
FULL_RUN_APPROVAL_TOKEN=
