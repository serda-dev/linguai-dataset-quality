# Runtime only; set strong unique values outside git.
DATABASE_URL=postgresql://quality:change-me@postgres:5432/quality
ADMIN_TOKEN=change-me
TEACHER_BASE_URL=http://mock-teacher:8090/v1
TEACHER_API_KEY=
TEACHER_MODEL=mock-quality
TEACHER_PROFILE=local-mock-v1
ARTIFACT_DIR=/artifacts
MAX_DOCUMENT_BYTES=100000
MAX_ATTEMPTS=3
# Set DATABASE_URL with URL-encoded reserved password characters in production.
MAX_DATABASE_BYTES=8000000000
MAX_EXPORT_BYTES=1000000000
MIN_ARTIFACT_FREE_BYTES=2000000000
UNAPPROVED_JOB_CEILING=5000
# Separate from ADMIN_TOKEN. Leave unset until user explicitly authorizes a large run.
FULL_RUN_APPROVAL_TOKEN=
